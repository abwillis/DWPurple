# DWPurple - OS/2 build (GCC + kLIBC, OMF), e.g. from the ArcaOS/RPM toolchain.
#
#   make -f Makefile.os2 DW_DIR=<dwindows source> PURPLE_DIR=<libpurple prefix>
#
# Expects dw.lib/dw.dll from Dynamic Windows and the libpurple, GLib and
# libxml2 import libraries.  Set PURPLE_CFLAGS / PURPLE_LIBS directly if
# pkg-config is not available.

CC        = gcc
CFLAGS   ?= -O2 -g
DW_DIR   ?= ../dwindows
DW_CFLAGS ?= -I$(DW_DIR)
DW_LIBS   ?= -L$(DW_DIR) -ldw

PKG_CONFIG ?= pkg-config
PURPLE_CFLAGS ?= $(shell $(PKG_CONFIG) --cflags purple glib-2.0 gobject-2.0 gmodule-2.0)
PURPLE_LIBS   ?= $(shell $(PKG_CONFIG) --libs purple glib-2.0 gobject-2.0 gmodule-2.0)

SRCS = main.c core.c eventloop.c util.c blist.c accounts.c conv.c emoji.c \
       request.c notify.c xfer.c plugins.c debugwin.c sound.c idle.c \
       pounces.c prefs.c roomlist.c privacy.c tray.c gdklock.c ircconsole.c clipimg.c
OBJS = $(addprefix build/,$(SRCS:.c=.o))

ALL_CFLAGS = -Zomf -Zmt -std=gnu99 -Wall -Wno-unused-parameter -D__ST_MT_ERRNO__ \
             $(CFLAGS) $(DW_CFLAGS) $(PURPLE_CFLAGS)

all: dwpurple.exe

dwpurple.exe: $(OBJS) dwpurple.def
	$(CC) -Zomf -Zmt -Zmap -o $@ $(OBJS) dwpurple.def $(DW_LIBS) $(PURPLE_LIBS)

build/%.o: src/%.c src/dwpurple.h | build
	$(CC) $(ALL_CFLAGS) -c $< -o $@

build:
	mkdir -p build

clean:
	-rm -rf build dwpurple.exe dwpurple.map
